NEXT_PUBLIC_SERVER_URL="http://localhost:8000"

# Firebase Web app config (Project settings → General → Your apps → Web app).
# These are public by design — they identify the project, they do not authorise
# anything. Access is controlled by Firebase Auth and the agent's token check.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="<project-id>.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Enable Google as a sign-in provider:
#   Firebase console → Authentication → Sign-in method → Google
# And authorise the origins you serve from:
#   Authentication → Settings → Authorized domains (localhost is there by default)
